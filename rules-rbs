name: Manual Build Custom Nginx
on:
  workflow_dispatch:

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        debian_version: [bookworm, trixie]
    
    runs-on: ubuntu-latest
    container: debian:${{ matrix.debian_version }}

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install Debian Build Stack (HTTPS Fix)
        run: |
          # 1. Initialize HTTPS support
          apt-get update && apt-get install -y ca-certificates apt-transport-https
          
          # 2. Nuclear wipe of ALL sources (main and directory) to kill 404 ghosts
          rm -rf /etc/apt/sources.list.d/*
          echo "" > /etc/apt/sources.list
          
          # 3. Reconstruct using ABSOLUTE HTTPS paths (The /debian/ suffix is mandatory)
          cat <<EOF > /etc/apt/sources.list
          deb https://deb.debian.org ${{ matrix.debian_version }} main
          deb-src https://deb.debian.org ${{ matrix.debian_version }} main
          deb https://deb.debian.org ${{ matrix.debian_version }}-updates main
          deb-src https://deb.debian.org ${{ matrix.debian_version }}-updates main
          EOF

          # 4. Correct Security Paths (Using the official /debian-security/ subfolder)
          if [ "${{ matrix.debian_version }}" = "bookworm" ]; then
            cat <<EOF >> /etc/apt/sources.list
            deb https://deb.debian.org bookworm-security main
            deb-src https://deb.debian.org bookworm-security main
          EOF
          fi

          # 5. Clean, Update, and Install Build Essentials
          apt-get clean
          apt-get update -y
          apt-get install -y dpkg-dev devscripts debhelper fakeroot ruby ruby-dev \
          build-essential libcurl4-openssl-dev libssl-dev zlib1g-dev git wget

      - name: Clone Fresh Modules
        run: |
          mkdir -p /opt/nginx-modules
          git clone --single-branch --depth 1 https://github.com/nginx/njs.git /opt/nginx-modules/njs

      - name: Build Passenger Dynamic Module (Parallel)
        run: |
          gem install passenger 
          # Robust path detection for Ruby 3.1 vs 3.3
          PASSENGER_ROOT=$(gem env gemdir)/gems/$(gem list passenger | grep passenger | head -n 1 | awk '{print $1 "-" $2}' | tr -d '()')
          PASSENGER_SRC="$PASSENGER_ROOT/src/nginx_module"
          
          # Speed up compilation with all available CPU cores
          cd "$PASSENGER_SRC" && rake nginx:as_dynamic_module CACHING=false -j$(nproc)
          
          # Export to GITHUB_ENV for the Nginx build
          echo "PASSENGER_PATH=$PASSENGER_SRC" >> $GITHUB_ENV

      - name: Fetch Nginx Source and Update Changelog
        run: |
          apt-get build-dep -y nginx
          apt-get source nginx
          cd nginx-*/
          
          export DEBFULLNAME="Nginx Packaging"
          export DEBEMAIL="nginx-packaging@f5.com"
          
          # Generate version string: e.g. 1.29.5-1~rbs~trixie
          ORIG_VERSION=$(dpkg-parsechangelog -S Version)
          NEW_VERSION="${ORIG_VERSION}~rbs~${{ matrix.debian_version }}"
          
          # dch automatically handles the timestamp replacement
          dch --newversion "$NEW_VERSION" \
              --distribution "${{ matrix.debian_version }}" \
              --force-distribution \
              --force-bad-version \
              "Automated build for version $ORIG_VERSION by RBS."

          # Inject your custom rules file
          cp ../rules-rbs debian/rules
          chmod +x debian/rules

      - name: Run dpkg-buildpackage (High Speed)
        run: |
          cd nginx-*/
          # -j$(nproc) ensures Nginx also compiles using all cores
          dpkg-buildpackage -rfakeroot -uc -b -j$(nproc)

      - name: Upload .deb Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: nginx-binaries-${{ matrix.debian_version }}
          path: ./*.deb

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: "manual-build-${{ matrix.debian_version }}-${{ github.run_id }}"
          files: ./*.deb
          name: "Nginx Build (${{ matrix.debian_version }})"
          body: "Custom Nginx build for ${{ matrix.debian_version }}. Compiled on $(date)."
