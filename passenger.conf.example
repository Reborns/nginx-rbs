# Passenger example. The module is built but not loaded by default.
#
# Load it at the top of nginx.conf:
#   load_module modules/ngx_http_passenger_module.so;
# Docker image:
#   ln -s /etc/nginx/modules-available/50-http-passenger.conf /etc/nginx/modules-enabled/
#
# Then copy this file to /etc/nginx/conf.d/passenger.conf and uncomment.
# Paths are filled in at build time; check them with `passenger-config --root`.

# passenger_root @PASSENGER_ROOT@;
# passenger_ruby @PASSENGER_RUBY@;
# passenger_instance_registry_dir /tmp;
# passenger_max_pool_size 5;
# passenger_min_instances 1;

# server {
#     listen 80;
#     server_name app.example.com;
#     root /srv/app/public;
#
#     passenger_enabled on;
#     passenger_app_env production;
# }
